{
  "name": "heart-history",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ocr:bench": "tsx tools/ocr-bench.ts",
    "ocr:debug": "tsx tools/ocr-debug.ts",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "build:apk:local": "npx eas-cli build --platform android --profile preview --local",
    "build:apk:prod": "npx eas-cli build --platform android --profile production-apk",
    "build:aab": "npx eas-cli build --platform android --profile production",
    "build:dev": "npx eas-cli build --platform android --profile development",
    "ocr:real": "tsx tools/ocr-real.ts",
    "build:apk:assisted": "npx eas-cli build --platform android --profile assisted-apk",
    "ocr:folders": "tsx tools/ocr-folders.ts",
    "ocr:server": "powershell -ExecutionPolicy Bypass -File server/ocr.ps1 status",
    "ocr:server:start": "powershell -ExecutionPolicy Bypass -File server/ocr.ps1 start",
    "ocr:server:stop": "powershell -ExecutionPolicy Bypass -File server/ocr.ps1 stop",
    "ocr:server:restart": "powershell -ExecutionPolicy Bypass -File server/ocr.ps1 restart"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "base64-js": "^1.5.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.15",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
